{
  "expo": {
    "name": "CRESCO Key",
    "slug": "cresco-key",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "crescokey",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CRESCO Key uses the camera to scan payment QR codes."
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.faadil.crescokey"
    }
  }
}
