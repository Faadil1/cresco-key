EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_APP_IDENTITY_URI=https://REPLACE_WITH_VERIFIED_APP_DOMAIN

# CRESCO Key onchain authority. Do not reuse the original CRESCO program id.
EXPO_PUBLIC_CRESCO_KEY_PROGRAM_ID=

# Explicit token program for the P0 payment mint. Example only:
# TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
EXPO_PUBLIC_DEMO_TOKEN_PROGRAM_ID=
EXPO_PUBLIC_DEMO_TOKEN_DECIMALS=6

# Current deterministic Mandate nonce used by the demo setup.
EXPO_PUBLIC_DEMO_MANDATE_NONCE=

# Guardian public wallet address used to route the private boundary request.
EXPO_PUBLIC_DEMO_GUARDIAN_WALLET=

# Optional alternate valid wallet used by the hostile changed-recipient demo.
EXPO_PUBLIC_DEMO_MUTATED_RECIPIENT=

# Optional deterministic public Solana Pay intents emitted by the Devnet
# bootstrap receipt. These make G1 mobile testing possible without relying on
# camera/QR setup in every runtime.
EXPO_PUBLIC_DEMO_SOLANA_PAY_IN_BOUNDS_5=
EXPO_PUBLIC_DEMO_SOLANA_PAY_BOUNDARY_12=
EXPO_PUBLIC_DEMO_SOLANA_PAY_CHANGED_RECIPIENT_12=

# Private relay. Do not put secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_BOUNDARY_RELAY_URL=https://REPLACE_WITH_RELAY.workers.dev
