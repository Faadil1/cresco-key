{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cresco-key-boundary-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-26",
  "durable_objects": {
    "bindings": [
      {
        "name": "BOUNDARY_REQUESTS",
        "class_name": "BoundaryRequestObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoundaryRequestObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
